# Copy to backend/.env and adjust as needed. All variables are optional.
SAARPS_ENVIRONMENT=development
SAARPS_API_PREFIX=/api/v1
# JSON list of allowed browser origins
SAARPS_CORS_ORIGINS=["http://localhost:3000"]
# Override data/model locations (default: <repo>/data and <repo>/models)
# SAARPS_DATA_DIR=/absolute/path/to/data
# SAARPS_MODELS_DIR=/absolute/path/to/models
